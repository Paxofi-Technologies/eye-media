# Copy to .env and fill in. Never commit real values.
# MySQL 8 / MariaDB 10.6+ (cPanel: create the DB + user in "MySQL Databases").
DATABASE_URL=mysql://eyemedia:eyemedia_dev@localhost:3306/eyemedia

# Public base URL (used for canonical URLs, sitemap and Open Graph tags)
SITE_URL=http://localhost:3000

# Set to true ONLY on the production domain. Anything else (staging) sends noindex to search engines.
SITE_INDEXING=false

# --- Mux (video hosting, uploads and live streaming). See docs/MUX-SETUP.md ---
# Without these, video upload and live streaming are switched off.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Optional: basic | plus | premium (leave empty for Mux's default)
MUX_VIDEO_QUALITY=
# Optional: seconds a live stream may drop before the broadcast counts as finished
MUX_RECONNECT_WINDOW=
# Optional: true sends viewer analytics to Mux Data (off by default; update the privacy policy first)
MUX_DATA_ENABLED=

# --- EyeReport hand-off (shared secret with the EyeReport platform). See docs/EYE-REPORT-INTEGRATION.md ---
# 64 random letters/numbers (openssl rand -hex 32); different per environment.
EYE_REPORT_WEBHOOK_SECRET=
# https address on EyeReport that receives publish/reject decisions
EYE_REPORT_CALLBACK_URL=

# Folder of OLD uploaded videos (from before Mux). Read-only; leave empty on new installs.
MEDIA_DIR=

# Secret used to hash submitter IP addresses for abuse control (32+ random chars).
# Generate with: openssl rand -base64 32
IP_HASH_SECRET=change-me-to-a-long-random-string

# Optional: first admin account created by `npm run db:seed` (dev only).
SEED_ADMIN_EMAIL=admin@eyemedia.local
SEED_ADMIN_PASSWORD=
